# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB) ----
# Local:  mongodb://127.0.0.1:27017/bookleaf
# Atlas (free M0): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookleaf
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI (Google Gemini - free tier). Get a key: https://aistudio.google.com/apikey
# Leave empty and the app still works (rule-based classifier + template drafts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=12000
